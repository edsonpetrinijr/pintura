# Copiar para .env e preencher com valores reais. Nunca commitar o .env real.

# RTSP da camera que enxerga a linha de ganchos
RTSP_URL=rtsp://usuario:senha@ip-da-camera:554/stream1

# Segunda vista da MESMA cabine, na diagonal da anterior. Serve para cruzar as
# duas leituras: gancho que uma vista nao resolve, a outra costuma resolver.
CAMERA_46_URL=rtsp://admin:2035@10.101.244.46:554

# API interna que informa quais pecas estao sendo carregadas em quais ganchos
PARTS_API_URL=http://b8wdwisep02.brazil.cat.com:3030/PartBldYJSON

# Cameras da linha usadas para sincronizar com a API de pecas
CAMERA_26_URL=rtsp://admin:2035@10.101.244.26:554
CAMERA_27_URL=rtsp://admin:2035@10.101.244.27:554

# Maximo Visual Inspection (Maximo Application Suite)
MVI_BASE_URL=https://seu-host-mas.exemplo.com
MVI_API_KEY=coloque-a-api-key-aqui
MVI_MODEL_ID=coloque-o-id-do-modelo-implantado-aqui
# Path exato do endpoint de inferencia do modelo implantado.
# Pegue o valor certo na aba "API" do modelo implantado no MVI (ele mostra um curl pronto).
MVI_INFERENCE_PATH=/api/dlapis/{model_id}

# Limiar minimo de confianca para considerar uma deteccao valida (0.0 a 1.0)
MVI_CONFIDENCE_THRESHOLD=0.5

# Se o MVI usa certificado self-signed, mude para false (nao recomendado em producao)
MVI_VERIFY_SSL=true
